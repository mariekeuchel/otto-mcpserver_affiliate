# Aus dem Publisher-Account: Statistiken -> API (https://partnerprogramm.otto.de/statistic-api.do)
OTTO_API_ACCESS_TOKEN=
OTTO_PUBLISHER_ID=

# Optional
# OTTO_API_BASE_URL=https://partnerprogramm.otto.de
# OTTO_API_FORMAT=csv          # csv oder json
# OTTO_CACHE_TTL=300           # Sekunden
# OTTO_API_TIMEOUT=60

# Spaltennamen manuell festlegen, falls die automatische Erkennung nicht greift (kommagetrennt)
# OTTO_FIELD_TURNOVER=turnover
# OTTO_FIELD_COMMISSION=commission
# OTTO_FIELD_STATUS=processingstate
# OTTO_FIELD_DATE=timestamp
# OTTO_FIELD_ADMEDIA=admedia_id

# Schutz des MCP-Endpunkts (Bearer-Token; mehrere kommagetrennt möglich)
MCP_AUTH_TOKEN=
